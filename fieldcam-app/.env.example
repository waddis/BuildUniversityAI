# ===========================================
# fieldcam.app Environment Variables
# ===========================================

# Database
DATABASE_URL=postgresql://fieldcam:fieldcam@localhost:5432/fieldcam
DATABASE_TEST_URL=postgresql://fieldcam:fieldcam@localhost:5432/fieldcam_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MAGIC_LINK_SECRET=change-me-magic-link-secret
MAGIC_LINK_EXPIRE_MINUTES=15

# Storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=fieldcam-media
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/fieldcam-media

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (for magic links, invites)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fieldcam.app

# Worker
WORKER_CONCURRENCY=4
